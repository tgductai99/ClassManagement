@using TaskQLLH.Web.Models.Common.Modals

@{
    Layout = null;
}

<div class="modal fade" id="ClassRoomCreateModal" tabindex="-1" role="dialog" 
     aria-labelledby="ClassRoomCreateModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", 
                new ModalHeaderViewModel(L("CreateNewClassRoom")))
            <form name="ClassRoomCreateForm" role="form" class="form-horizontal">
                <div class="modal-body">
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">@L("ClassRoomName")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Name" 
                                   required maxlength="100" />
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">@L("ClassRoomCode")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="Code" 
                                   required maxlength="20" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">@L("Description")</label>
                        <div class="col-md-9">
                            <textarea class="form-control" name="Description" 
                                      rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">@L("AcademicYear")</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control" name="AcademicYear" 
                                   placeholder="2024-2025" maxlength="20" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">@L("Semester")</label>
                        <div class="col-md-9">
                            <select class="form-control" name="Semester">
                                <option value="1">@L("Semester1")</option>
                                <option value="2">@L("Semester2")</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">@L("MaxStudents")</label>
                        <div class="col-md-9">
                            <input type="number" class="form-control" name="MaxStudents" 
                                   min="1" value="30" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">@L("ClassRoomStatus")</label>
                        <div class="col-md-9">
                            <select class="form-control" name="Status">
                                <option value="1">@L("ClassRoomActive")</option>
                                <option value="2">@L("ClassRoomInactive")</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">@L("IsActive")</label>
                        <div class="col-md-9">
                            <input type="checkbox" name="IsActive" value="true" checked />
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>